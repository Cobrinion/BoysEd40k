          </costs>
          <profiles>
            <profile name="The Soul Glaive" id="84c7-9d70-1fc5-9b07" hidden="false" typeId="66fe-f217-d00c-847a" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="1fc0-83ca-e978-5a16">-</characteristic>

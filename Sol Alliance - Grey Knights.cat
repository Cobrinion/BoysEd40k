                  <characteristics>
                    <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Friendly units do not scatter when they Deep Strike, so long as the first model placed is within 6&quot; of a model with a locator beacon. The locator beacon must have been on the battlefield at the start of the turn in order for it to be used.</characteristic>
                  </characteristics>
                </profile>
              </profiles>

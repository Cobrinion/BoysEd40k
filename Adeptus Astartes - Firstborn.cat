              </costs>
              <infoLinks>
                <infoLink name="Digital Weapons" id="276f-0362-1298-674c" hidden="false" targetId="d77f-7c72-6661-6bfa" type="rule"/>
              </infoLinks>
            </selectionEntry>
            <selectionEntry name="Melta Bombs" id="f81e-4110-9f7f-67af" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="21e0-940a-7e97-2c4e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>

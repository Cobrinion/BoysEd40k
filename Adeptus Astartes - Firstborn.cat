        <selectionEntry name="Relic of the Unforgiven" id="0bda-4f3d-aca7-1616" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9a82-79d0-0c3b-ce73" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="10"/>
          </costs>
          <profiles>
            <profile name="Relic of the Unforgiven" id="cbe2-3689-b270-e50b" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A relic of the Unforgiven is borne to battle by a Watcher in the Dark. A Relic Bearer is represented by a separate miniature that will always remain as close as possible to the unit that selected it. The model itself is purely decorative and is always ignored for game purposes.


Models in a unit that includes a Relic Bearer carrying a perfidious relic of the Unforgiven have the  Fear (1) special rules.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Terminator Armour Selection:" id="1180-f2ef-5b64-4288" defaultSelectionEntryId="f218-7caf-3b76-08ef" hidden="false">
          <constraints>
            <constraint id="ca6a-e180-a932-dc3d" field="selections" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="2eaa-8c48-d0de-2a50" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Indomitus" id="fb58-9fb3-2ac7-e242" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4fb7-f825-8091-572c" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>

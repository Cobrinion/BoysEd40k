    <selectionEntry name="Ragnar Blackmane" id="6896-87ba-b73a-29d4" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="aaeb-7f68-d32b-d039" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="195"/>
      </costs>
      <entryLinks>
        <entryLink name="Frag and Krak Grenades" id="4446-eaa6-6893-348c" collective="false" hidden="false" import="true" targetId="9d9b-365a-34ae-2145" type="selectionEntry"/>
        <entryLink name="Warlord" id="6a43-1644-3b42-8bdb" collective="false" hidden="false" import="true" targetId="b5c7-2370-f88b-eff9" type="selectionEntry">
          <rules>
            <rule name="Saga of the Warrior Born" id="28b9-aa96-b0ac-8fed" hidden="false">
              <description>When fighting in a challenge, Ragnar re-rolls all failed To Hit rolls.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Howl of the Death Wolf" id="22b8-bc0c-ede0-d8b3" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0a4f-9f6e-2e94-5f57" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="2951-2dcd-0601-422f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Fleet" id="ffd0-2441-61ee-f472" hidden="false" targetId="b1ba-0709-4305-88e2" type="rule">
                  <modifiers>
                    <modifier field="name" type="set" value="Howl of the Wolf"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <rules>
                <rule name="Howl of the Wolf" id="fcf7-4813-0b83-8c08" hidden="false">
                  <description>With a single howl from the Warlords lips, the Rout is spurred to action, taking the final killing sprint to deliver the death blow all to the echoing cry of his warriors. Once per game, a Warlord with this trait may declare it will howl. For the rest of that turn, all Space Wolves units in your army gain the benefits of the Fleet (2) special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Rage of the Berserker" id="5a03-c69c-4e05-d423" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8d35-c22b-d460-f3e5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="039a-e623-1a65-c6e5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Rage" id="b98b-e190-93aa-e110" hidden="false" targetId="8c0c-8856-f1ab-923d" type="rule">
                  <modifiers>
                    <modifier field="name" type="set" value="Rage (3)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <rules>
                <rule name="Rage of the Berserker" id="e755-b2e6-704c-9f58" hidden="false">
                  <description>The Warlord channels the fury of a Berserker like few others. Many of his men speak that he is already taken with the curse of the Wulfen. This Warlord gains the Rage (3) special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </entryLink>
        <entryLink name="Runic Armour" id="3a20-bff9-8b54-b383" collective="false" hidden="false" import="true" targetId="cf86-6527-d330-300d" type="selectionEntry">
          <modifiers>
            <modifier field="e7de-8dcf-403a-b76a" type="set" value="10"/>
            <modifier field="name" type="set" value="May take Runic Armour:"/>
          </modifiers>
        </entryLink>
      </entryLinks>

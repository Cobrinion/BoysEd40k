        <profile name="Dreadnought Grapple" id="6917-ce49-651f-f159" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A Stormraven Gunship may use it&apos;s grappling cables to carry a single Dreadnought of any type. If a Zooming Stormraven Gunship is wrecked or suffers a Crash and Burn! result, the embarked Dreadnought suffers a Strength 10 hit on its rear armour; if the Stormraven Gunship is Hovering, the hit is Strength 4 instead.</characteristic>
          </characteristics>
        </profile>
      </profiles>

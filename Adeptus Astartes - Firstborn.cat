        <entryLink name="Warlord" id="5c2f-cd17-4441-2f5a" collective="false" hidden="false" import="true" targetId="b5c7-2370-f88b-eff9" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Bolt Pistol" id="0ce0-41b6-5ce8-fb23" hidden="false" targetId="2cb8-e71e-1b53-17fc" type="profile"/>

        <selectionEntry name="Apothecary" id="fef8-f064-aed2-bbaf" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9a08-a099-e12d-f30d" field="selections" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="4f0f-2ef7-8fde-ea8b" field="selections" scope="parent" shared="true" type="max" value="8"/>

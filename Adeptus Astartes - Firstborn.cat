        <selectionEntryGroup name="Veterancy" id="26ae-de03-e09b-e5ab" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="0a20-1f29-df3a-7255" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="min" value="0"/>
            <constraint id="e459-797a-15a0-f74c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Veterans of Ferrum Magna" id="711b-b5a8-a392-2fea" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
              </costs>
              <rules>
                <rule name="Veterans of Ferrum Magna" id="b997-cb9b-29cd-0257" hidden="false" page="28" publicationId="3ff9-2058-b559-545b">
                  <description>These veterans fought in the Seige of Ferrum Magna to occupy a rebelling Forgeworld in the Lion&apos;s name. The unit gains 1 on their Armour Penetration rolls.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Veterans of the 41st Millenium" id="2472-ba45-e809-9083" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
              </costs>
              <rules>
                <rule name="Veterans of the 41st Millenium" id="7d9d-5049-aa91-db9d" hidden="false">
                  <description>These Veterans have seen countless conflicts which has hardened their resolve beyond that of even a normal Space Marine. 
The unit gains the Stubborn special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Veterans of The Solar Schism" id="9315-f8a3-7ebd-8dea" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
              </costs>
              <rules>
                <rule name="Veterans of the Solar Schism" id="bbff-ef5c-9636-51fa" hidden="false">
                  <description>Having fought through the civil war between Lion&apos;el Johnson and Roboute Guilliman, these Firstborn Space Marines have become all to accoustumed to fighting their Primaris successors. 
This unit gains +1 Initiative on the first turn of combat when fighting against Primaris Space Marines</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Veterans of the Badab Wars" id="5ef5-6f3f-9783-c096" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
              </costs>
              <rules>
                <rule name="Veterans of the Badab Wars" id="8ffe-a56d-6018-4dee" hidden="false" page="28" publicationId="3ff9-2058-b559-545b">
                  <description>Hard-fought campaigns against Traitor Astartes have taught these Marines how best to handle their wayward brethren. The unit gains (Preferred Enemy: Chaos Space Marines).</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Veterans of The Damocles Crusade" id="990d-d14a-b596-72c0" hidden="false" import="true" type="upgrade">
              <rules>
                <rule name="Veterans of the Damocles Crusade" id="e077-9201-acb2-e3e3" hidden="false">
                  <description>Having fought against the technologically advanced Tau, these veterans excel at countering alien technologies. The unit gains (Preferred Enemy: Xenos).</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>

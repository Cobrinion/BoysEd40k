            <characteristic name="Special Rules" typeId="3df9-f556-8725-fe75">Fury of the Firstborn, Firstborn Astartes</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="e8fa-a6b3-0e8c-18aa" type="set" value="7&quot;">
              <conditions>
                <condition childId="18c2-d2d7-fa35-5639" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="d490-2cf8-a366-637b" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
            <modifier field="2ba2-3a82-dfb7-7849" type="set" value="Infantry (Heavy)">
              <conditionGroups>

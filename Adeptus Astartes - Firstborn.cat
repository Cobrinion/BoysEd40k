          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="25"/>
          </costs>
          <profiles>
            <profile name="Legion Standard" id="0f66-6ca0-e70d-f4d0" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Friendly units with the Blood Angels Faction within 12&quot; of a model with a Legion Standard re-roll failed Morale checks and Pinning tests. In addition, all friendly models with the Blood Angels Faction in the same unit as this standard have +1 Attack whilst the bearer is alive.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>

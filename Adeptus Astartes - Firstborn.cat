    <selectionEntry name="Bjorn the Fell-Handed" id="5c19-f4bd-0b0c-c791" collective="false" hidden="false" import="true" type="model">
      <constraints>
        <constraint id="e2e9-b550-0d98-b1bc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="240"/>
      </costs>
      <entryLinks>
        <entryLink name="Dreadnought" id="bca2-9cb3-f8ac-0a43" collective="false" hidden="false" import="true" targetId="920a-971e-547e-e7c0" type="selectionEntry"/>
      </entryLinks>
      <profiles>
        <profile name="Bjorn the Fell-Handed (Heavy)" id="8900-4190-4246-ae71" hidden="false" typeId="17f0-d093-bacf-886d" typeName="Dreadnought">
          <characteristics>
            <characteristic name="M" typeId="8fac-a846-de69-9178">6&quot;</characteristic>
            <characteristic name="WS" typeId="ffe9-2a7f-bd4e-66cc">6</characteristic>
            <characteristic name="BS" typeId="0ddb-0fe2-6393-7c9e">6</characteristic>
            <characteristic name="S" typeId="860b-ab05-e422-b9db">7</characteristic>
            <characteristic name="T" typeId="8fc3-a8c7-c14d-9e62">6</characteristic>
            <characteristic name="W" typeId="7e98-a40e-cf96-4a4b">6</characteristic>
            <characteristic name="I" typeId="f7c5-664d-a82a-946f">5</characteristic>
            <characteristic name="A" typeId="b53b-1fc5-02c8-e69b">5</characteristic>
            <characteristic name="Ld" typeId="3886-1fbc-9ba4-cb2c">9</characteristic>
            <characteristic name="Save" typeId="ab97-0508-cfbe-db94">2+/5++</characteristic>
            <characteristic name="Special Rules" typeId="c5fa-39b7-33f9-cb47"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Ancient Tactician" id="eeb2-c3a3-9c94-15c2" hidden="false">
          <description>Bjorn has masterminded many of the Space Wolves&apos; greatest victories, and by his hand have some of the Imperium&apos;s most heinous adversaries been slain. An army that includes Bjorn the Fell-Handed adds +1 to any Seize the Initiative rolls it makes.</description>
        </rule>
        <rule name="Ward of the Primarch" id="ba22-ae26-42e3-a91f" hidden="false">
          <description>Legend claims that the spirit of Russ ever watches over Bjorn, and that no harm will come to him until the primarch returns to fight alongside his friend once more in the battle to end all things -- the Wolftime. As such, Bjorn the Fell-Handed has a 5+ invulnerable save.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Searchlight and Smoke Launchers" id="bfc9-449b-f650-5774" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="763c-7c8c-5146-fe5b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="f29c-8b9b-11eb-d16c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
          </costs>
          <profiles>
            <profile name="Searchlight" id="3784-c0bf-687e-8c14" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Night fighting only. After firing all of it&apos;s weapons, this model can choose to illuminate its target with the searchlight. If it does, it also illuminates itself.</characteristic>
              </characteristics>
            </profile>
            <profile name="Smoke Launchers" id="e3b0-90d9-5e61-4fbc" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Once per game, instead of shooting or flat out movements/running, this vehicle can activate smoke launchers. It may not fire its weapons that turn but it recieves a 5+ cover save until the next player turn. This is unaffected by weapon destroyed, crew shaken and crew stunned results.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>

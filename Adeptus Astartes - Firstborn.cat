        <profile name="Leman Russ" id="a273-58a0-7ac6-b0dd" hidden="false" typeId="35bb-3fdd-dd9d-1fc8" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="2ba2-3a82-dfb7-7849">Primarch (Unique, Skirmish)</characteristic>
            <characteristic name="M" typeId="e8fa-a6b3-0e8c-18aa">8&quot;</characteristic>
            <characteristic name="WS" typeId="9660-0df5-9c5d-3604">8</characteristic>

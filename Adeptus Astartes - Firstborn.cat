        <modifier field="3bd6-2c04-8d3f-2a11" type="increment" value="5">
          <repeats>
            <repeat childId="any" field="e7de-8dcf-403a-b76a" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="roster" shared="true" value="500"/>
          </repeats>
        </modifier>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="9080-889f-6881-4abf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Blood Angels Wargear" id="657b-e067-0d9c-4973" hidden="false">
          <description>Wargear from the ancient battlechambers on Baal said to come from the age of Heresy. So rare are these weapons, that only few may be taken into battle at any one time. 
For every 500 points in this army, five weapons from the Blood Angels Wargear arsenal may be selected</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Coriolis Pattern Power Shield" id="cbb4-bde2-56a5-b816" collective="false" hidden="false" import="true" type="upgrade">

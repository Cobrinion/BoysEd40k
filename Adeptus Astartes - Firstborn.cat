            <constraint id="ac54-423f-3f1f-585b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="5"/>
          </costs>
          <profiles>
            <profile name="Runic Armour" id="f4db-47a5-bd0b-f98d" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Runic Armour Confers a 2+ Armour save and 5+ Invulnerable save. The wearer may re-roll invulnurable saves against Psychic weapons cast against them.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Wolf-tail Talisman" id="2aa8-6938-f390-00c2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b5cf-cbbf-664e-a925" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="5"/>
          </costs>
          <profiles>
            <profile name="Wolftail Talisman" id="0846-c730-4c77-435c" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">When a unit equipped with this wargear would be targeted for a Psychic Power or attack by a Psychic Weapon, roll a D6. On a 5+, that Psychic Power is negated. If it was a Psychic weapon, all of its attacks are considered to have automatically missed (no rolls are made).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Space Wolf Weapons:" id="1734-16af-94e4-8ef9" collective="false" hidden="false" import="true">

                    <profile name="Dozer Blade" id="27af-2256-0729-e913" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                      <characteristics>
                        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Vehicles equipped with dozer blades treat their front armour as one higher than normal when ramming. The vehicle can re-roll failed Dangerous Terrain tests.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>

          <characteristics>
            <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Death Masks shaped in the face of the Primarch Sanguinius, cause Fear (2)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Descent of Angels" id="0385-901a-ebd6-506d" hidden="false">
          <description>If this unit enters play via Deep Strike all enemy units within 6&quot; immediatly suffer D6 str 4 AP - hits. Roll once to determine the number of hits applied to all units within range.</description>
        </rule>
      </rules>
      <selectionEntries>

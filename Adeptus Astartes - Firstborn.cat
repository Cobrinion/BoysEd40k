          </characteristics>
        </profile>
        <profile name="Encarmine Broadsword" id="4c03-4683-ee5c-04f2" hidden="false" typeId="66fe-f217-d00c-847a" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="1fc0-83ca-e978-5a16">-</characteristic>
            <characteristic name="Strength" typeId="cb5e-ad7f-f63b-41cd">+1</characteristic>
            <characteristic name="AP" typeId="1544-3a5e-d421-edf9">2</characteristic>
            <characteristic name="Type" typeId="79ff-eaa1-5809-53f3">Master-Crafted, Two-Handed, Duelist&apos;s Edge</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Angelic Visage" id="af69-d849-d0d4-e2ea" hidden="false">
          <description>Enemy attacks have -1 to hit against this model in the Fight phase.</description>
        </rule>
        <rule name="Avenging Angel" id="1c11-25af-3b29-d3e1" hidden="false">
          <description>This unit any any unit it is attached to may re-roll charge rolls in the charge phase. 
If this unit is slain in the combat phase, it may fight again at Initiative 1 before being removed from play.</description>
        </rule>
        <rule name="Miraculous Saviour" id="a3b8-1d1b-7e96-82db" hidden="false">
          <description>This unit must begin the game in reserves if allowed. It may arrive from deepstrike anytime that a friendly model is succesfuly charged and must immediatly join the friendly unit. For the purpose of special rules, this movement counts as a charge.</description>
        </rule>
        <rule name="The Death Mask of the Great Angel" id="3730-d6a5-bb0a-d383" hidden="false">
          <description>This unit and any attached unit automatically pass Pinning and Panic tests. This unit has the Feel no Pain (5+) special rule. When this unit has at least 3 wounds allocated to it, it gains Feel no Pain (4+) instead.</description>
        </rule>
      </rules>
    </selectionEntry>

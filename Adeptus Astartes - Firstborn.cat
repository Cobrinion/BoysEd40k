      <selectionEntryGroups>
        <selectionEntryGroup name="Hexagrammaton" id="b9ce-a7dc-62f8-c89e" defaultSelectionEntryId="none" hidden="true">
          <constraints>
            <constraint id="2bbd-41ce-f931-a5be" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="56e9-4920-1b41-9133" field="selections" scope="parent" shared="true" type="min" value="1"/>
          </constraints>

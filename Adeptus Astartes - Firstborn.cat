      <selectionEntryGroups>
        <selectionEntryGroup name="Campaign Veterancy" id="5feb-8106-c0a4-6746" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="f3c4-8ab1-6886-65f5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="min" value="0"/>
            <constraint id="7bec-84db-8dc6-2db1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Veterans of Ferrum Magna" id="27ef-638e-1dea-1e97" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
              </costs>
              <rules>
                <rule name="Veterans of Ferrum Magna" id="bd8e-2f54-f436-fa00" hidden="false" page="28" publicationId="3ff9-2058-b559-545b">
                  <description>These veterans fought in the Seige of Ferrum Magna to occupy a rebelling Forgeworld in the Lion&apos;s name. The unit gains 1 on their Armour Penetration rolls.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Veterans of the 41st Millenium" id="fc49-fb96-a7dd-c0bd" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
              </costs>
              <rules>
                <rule name="Veterans of the 41st Millenium" id="daf4-2c4a-0053-335a" hidden="false">
                  <description>These Veterans have seen countless conflicts which has hardened their resolve beyond that of even a normal Space Marine. 
The unit gains the Stubborn special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Veterans of The Solar Schism" id="9975-97ae-e549-097f" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
              </costs>
              <rules>
                <rule name="Veterans of the Solar Schism" id="58d6-77c1-4896-817b" hidden="false">
                  <description>Having fought through the civil war between Lion&apos;el Johnson and Roboute Guilliman, these Firstborn Space Marines have become all to accoustumed to fighting their Primaris successors. 
This unit gains +1 Initiative on the first turn of combat when fighting against Primaris Space Marines</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Veterans of the Badab Wars" id="c23f-7347-891f-9ade" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
              </costs>
              <rules>
                <rule name="Veterans of the Badab Wars" id="60d7-714a-6e5d-3bd8" hidden="false" page="28" publicationId="3ff9-2058-b559-545b">
                  <description>Hard-fought campaigns against Traitor Astartes have taught these Marines how best to handle their wayward brethren. The unit gains (Preferred Enemy: Chaos Space Marines).</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Veterans of The Damocles Crusade" id="b51f-94fd-406d-d791" hidden="false" import="true" type="upgrade">
              <rules>
                <rule name="Veterans of the Damocles Crusade" id="6a02-d4a3-81da-b834" hidden="false">
                  <description>Having fought against the technologically advanced Tau, these veterans excel at countering alien technologies. The unit gains (Preferred Enemy: Xenos).</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>

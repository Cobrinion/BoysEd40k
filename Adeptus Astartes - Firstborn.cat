        <profile name="Legion Standard" id="d552-2f20-1c95-ead8" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">All of the controlling player’s units with the Legiones Astartes (X) special rule within 6&quot; of a friendly model with a Legion standard are considered to have a Leadership Characteristic of 10 when resolving Morale checks or Pinning tests (but not Psychic checks).</characteristic>
          </characteristics>
        </profile>

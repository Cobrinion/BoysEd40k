  <publications>
    <publication name="Book 1 The Council on Terra" id="cfcf-7aa1-fe59-68ec"/>
  </publications>
  <rules>
    <rule name="Vengeful Strike" id="f498-d577-ff6e-2688" hidden="false" page="154" publicationId="cfcf-7aa1-fe59-68ec">
      <description>All ranged weapons are Twin-Linked on the turn this Deathwing model deep strikes.</description>
    </rule>
    <rule name="Fury of the Firstborn" id="ba1a-4f70-4e54-4fe2" hidden="false">
      <description>If a model with this special rule has not moved or Run during the Movement phase of its controlling player’s turn then that model may add one to the number of shots fired when making a Shooting Attack with a bolter (this does not include combi-bolters, bolt pistols or other bolt weapons).</description>
    </rule>
    <rule name="Pride of the Wolf" id="d3c2-f72a-0dc3-fa05" hidden="false">
      <description>Ragnar can re-roll a single failed saving throw in each Assault phase.
Ragnar and all Space Wolves models in his unit have the Furious Charge (1) special rule.
Ragnar must always issue and accept challenges when possible.</description>
    </rule>
  </rules>
  <sharedProfiles>
    <profile name="Combat Shield" id="a9ba-9836-8cc3-b199" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Combat shields and boarding shields confer a 6+ Invunurable save, increasing to 5 in close combat.</characteristic>
      </characteristics>
    </profile>

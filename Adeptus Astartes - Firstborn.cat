              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Reduce the result of all To Wound rolls made that target a model with a Coriolis pattern power shield by a weapon with the Melee type by -1</characteristic>
              </characteristics>
            </profile>

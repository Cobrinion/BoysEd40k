  </sharedSelectionEntries>
  <sharedSelectionEntryGroups>
    <selectionEntryGroup name="Armour Abilities" id="5774-1bee-79ed-ea2b" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="c074-bf60-83af-c2e7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Active Camoflage" id="56f7-e9a7-f417-ae33" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0a72-d2b3-a7c5-8d8b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="25"/>
          </costs>
          <profiles>
            <profile name="Active Camoflage" id="0380-fb66-acdc-3b23" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Active Camoflage confers the Stealth (4), and Infiltrate Special rules. If a unit with Active Camoflage suffers a wound, they lose the effects of Active Camoflage for the rest of the turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Dropshield" id="79f4-4106-bf4f-3bc2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bd93-f1fd-35bb-797b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="20"/>
          </costs>
          <profiles>
            <profile name="Dropshield" id="a665-8515-20d5-0638" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Once per game, a model with a Dropshield may choose to activate it. If it does so, place a 5&quot; blast marker directly under the model, with the model at it&apos;s centre. Any model within this blast marker may not be targeted by ranged weapons by models outside of the blast marker and in addition, may not target enemy models outside this blast marker. This dropshield lasts until the end of the player&apos;s next turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Evade" id="becc-cc46-9a48-930f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c3ba-d8c7-c40a-5c4d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
          </costs>
          <profiles>
            <profile name="Evade" id="9d39-006f-00d2-3f2a" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Once per game, a unit with Evade may activate this ability at the start of its turn. Until the start of its next turn, all ranged attacks targeting this unit suffer a -1 penalty to hit (i.e., they require +1 to successfully hit). In addition, the unit gains 4&quot; to its Movement characteristic for the duration of this turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Armour Lock" id="e178-5a20-d151-f5fe" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1869-d427-6d7d-7039" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
          </costs>
          <profiles>
            <profile name="Armour Lock" id="4193-a988-0494-327e" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Once per game, a model with Armour Lock may activate this ability after being hit but before Wound rolls are made. If it does, the model gains a 2+ Invulnerable Save until the end of its next turn. While Armour Lock is active, the model cannot move or make shooting attacks during its next turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Overshields" id="b341-d485-3d2d-6240" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c3f2-2a0d-3b3f-d639" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="25"/>
          </costs>
          <profiles>
            <profile name="Overshields" id="23d4-6c8a-b9b5-8158" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Once per game at the beginning of the player&apos;s turn, a model with Overshields may choose to activate them. When activated, the model immediately regenerates any Energy Shielding it has previously lost, returning it to its normal maximum value. In addition, it gains +1 Energy Shielding for the remainder of the game. This bonus point of Energy Shielding does not regenerate once lost and does not count toward the unit’s normal maximum Energy Shielding value</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>

              </modifiers>
              <profiles>
                <profile name="Small Point-Defence Gauntlet" id="d6cc-0e93-ecb2-be62" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A model equipped with a Small Point-Defence Gauntlet increases its Armor Save by +1 (to a maximum of 2+) against melee attacks made against it.

In addition, when resolving melee attacks, treat the model’s Toughness as 1 higher than normal for the purposes of determining whether it suffers Instant Death.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>

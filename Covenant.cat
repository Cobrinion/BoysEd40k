    <selectionEntryGroup name="Equipment" id="5acf-42e1-8cbd-6b2f" hidden="false">
      <selectionEntries>
        <selectionEntry name="Deployable Cover" id="a412-2f9c-050c-5ab8" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ad76-d12c-7d2c-8d1a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="5"/>
          </costs>
          <profiles>
            <profile name="Deployable Cover" id="031b-17fc-823c-557a" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Once per game, instead of shooting, a model equipped with Deployable Cover may place a Barrier Token anywhere within 3&quot; of itself. This token represents a low energy barrier or portable cover generator and follows the rules below.


Barrier Token
Treated as a piece of area terrain (2&quot; width and height).


Blocks Line of Sight for models that do not have LoS over 1&quot; tall obstacles.


The barrier remains in play until the end of the game or until it is targeted and destroyed by a shooting attack. For this purpose, treat the Deployable Cover as having Toughness 4 and a 4+ Armor Save.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Flare" id="0c83-3d2d-3c25-46fb" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cb32-aa52-5dfe-c764" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
          </costs>
          <profiles>
            <profile name="Flare" id="f427-de10-890c-cf31" hidden="false" typeId="66fe-f217-d00c-847a" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="1fc0-83ca-e978-5a16">8&quot;</characteristic>

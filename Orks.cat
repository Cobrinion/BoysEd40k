          <selectionEntries>
            <selectionEntry name="Prophet of Gork and Mork" id="ef81-fa83-1117-0fa6" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3420-0771-584b-2cec" field="selections" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="6724-d44f-629b-0dec" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Prophet of Gork and Mork" id="ea4a-a9ba-c44c-ba86" hidden="false">
                  <description>If Ghazghkull is your Warlord, he gains a 2+ Invulnerable save on any turn a Waaagh! is called. This invulnerable save lasts until the end of his next turn. In addition, Ghazghkull and all other models in his unit can Run on a turn he calls a Waaagh! despite having the Slow and Purposeful special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Deflektor" id="c2f7-9f82-a20c-bed9" hidden="false" targetId="4c7f-2e3e-5fcd-696c" type="profile"/>

          </characteristics>
        </profile>
        <profile name="Mork&apos;s Roar" id="e90e-70cf-2801-176d" hidden="false" typeId="66fe-f217-d00c-847a" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="1fc0-83ca-e978-5a16">36&quot;</characteristic>

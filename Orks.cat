    <profile name="&apos;Eavy armour" id="b4bf-d9d5-c49c-71cc" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">’Eavy armour confers a 4+ Armour Save.If a majority of models in a unit with the Light Sub-type are equipped with ‘eavy armour, the entire unit loses the Light Sub-
type</characteristic>
      </characteristics>
    </profile>
    <profile name="Twin-Linked Dakkagun" id="6048-80f9-bf9b-1d0e" hidden="false" typeId="66fe-f217-d00c-847a" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="1fc0-83ca-e978-5a16">18&quot;</characteristic>
        <characteristic name="Strength" typeId="cb5e-ad7f-f63b-41cd">5</characteristic>
        <characteristic name="AP" typeId="1544-3a5e-d421-edf9">5</characteristic>
        <characteristic name="Type" typeId="79ff-eaa1-5809-53f3">Assault 3, Twin-linked</characteristic>
      </characteristics>
    </profile>
    <profile name="Kustom Mega-Blasta" id="c457-f528-e79f-b829" hidden="false" typeId="66fe-f217-d00c-847a" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="1fc0-83ca-e978-5a16">24&quot;</characteristic>
        <characteristic name="Strength" typeId="cb5e-ad7f-f63b-41cd">8</characteristic>
        <characteristic name="AP" typeId="1544-3a5e-d421-edf9">4</characteristic>
        <characteristic name="Type" typeId="79ff-eaa1-5809-53f3">Assault 1, Blind, Breaching (4+), Gets Hot</characteristic>
      </characteristics>
    </profile>
    <profile name="Tellyport Blasta" id="802a-86f8-a224-1269" hidden="false" typeId="66fe-f217-d00c-847a" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="1fc0-83ca-e978-5a16">12&quot;</characteristic>
        <characteristic name="Strength" typeId="cb5e-ad7f-f63b-41cd">8</characteristic>
        <characteristic name="AP" typeId="1544-3a5e-d421-edf9">3</characteristic>
        <characteristic name="Type" typeId="79ff-eaa1-5809-53f3">Assault 1, Blast (3&quot;), Tellyported (6+)</characteristic>
      </characteristics>
    </profile>
    <profile name="Kustom Force Field" id="a304-4983-4bd8-8aa3" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">The bearer, and all models within 6&quot;, receive a 5+ invulnerable save against any shooting attacks. If the bearer is embarked in a vehicle, then the vehicle receives a 5+ invulnerable save against any shooting attacks instead.</characteristic>
      </characteristics>
    </profile>
    <profile name="Grot Blasta" id="d283-d3a6-3cce-b985" hidden="false" typeId="66fe-f217-d00c-847a" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="1fc0-83ca-e978-5a16">12&quot;</characteristic>
        <characteristic name="Strength" typeId="cb5e-ad7f-f63b-41cd">3</characteristic>
        <characteristic name="AP" typeId="1544-3a5e-d421-edf9">-</characteristic>
        <characteristic name="Type" typeId="79ff-eaa1-5809-53f3">Assault 1</characteristic>
      </characteristics>
    </profile>
    <profile name="Rokkit Pack" id="f397-4bfa-2933-a35a" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">At the start of the controlling player’s Movement phase,
or when deployed as part of a Deep Strike Assault, a
model with a rokkit pack may set its Move Characteristic
to a value of 12 for the duration of the controlling player’s
turn (sometimes referred to as ‘activating’ the rokkit
pack). This allows a model with a rokkit pack to move up
to 12&quot;, regardless of the Movement Characteristic shown
on its profile and gain any other benefits of a Movement
Characteristic of 12 (including the bonus to Charge
distance). In addition, all models with a rokkit pack that
have been activated ignore terrain while Moving and
Charging, but must take Dangerous Terrain tests as
normal when beginning or ending their Movement in
Dangerous Terrain.

A model with an activated rokkit pack
treats all Difficult Terrain as Dangerous Terrain and may
move over both friendly and enemy models or units
without penalty – but must end its Movement at least 1&quot;
away from any model from another unit.



A model with a rokkit pack may still Run if it would
normally be able to Run (this does not allow units that
include any models with the Heavy Sub-type to Run).
When making a Run move for a model with an activated
rokkit pack, roll a D6 and add the value to 12 to
determine how far it may move, rather than use the
model’s Initiative Characteristic. The model ignores
terrain and models from other units while making a Run
move with a rokkit pack as previously noted, but may not
make Shooting Attacks or declare a Charge in the same
turn in which it has Run as per the normal rules for
Running. If the D6 value is a 6, all models in the unit with
a rokkit pack must take a Dangerous Terrain test once the Run move is complete.



Any model with a rokkit pack also gains the Bulky (2),
Hammer of Wrath (1) and Deep Strike special rules.
During a Reaction made in any Phase, a player may not
choose to activate a model’s rokkit pack to gain any bonus
to their Movement Characteristic.</characteristic>
      </characteristics>
    </profile>
    <profile name="&apos;Ard Case" id="0a6f-71af-4b7d-5984" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A Vehicle with an ‘ard case loses the Open-topped Sub-
type. Access Points for the Vehicle with an ‘ard case will
be listed in the unit entry</characteristic>
      </characteristics>
    </profile>
    <profile name="&apos;Eavy Plates" id="8178-740e-f710-c890" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A Vehicle with ‘eavy plates increases the Armour Value on
its Front Facing by +2 and on its Side Facing by +1</characteristic>
      </characteristics>
    </profile>
    <profile name="Deflektor" id="4c7f-2e3e-5fcd-696c" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A model with a deflektor gains a 4+ Invulnerable Save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Lucky Tattoos" id="1801-552d-10ad-1fda" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A model with lucky tattoos gains a 6+ Invulnerable Save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mega Armour" id="907a-e9f5-428d-c6df" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Mega armour confers a 2+ Armour Save, and includes a
cybork body and an iron gob. A model in Mega Armour has the Slow and Purposeful special rule</characteristic>
      </characteristics>
    </profile>
    <profile name="Big Horns/Iron Gob" id="117b-a094-7813-15fd" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A model with big horns or an iron gob gains the Hammer
of Wrath (1) special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Billowing Fumes" id="c94c-ea5a-d9fd-9023" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A Vehicle with billowing fumes that chooses to move Flat
Out gains the Shrouded (5+) special rule until the start
of the controlling player’s next turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Boarding Plank" id="abe0-0558-3435-50e4" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">If a unit disembarks from a Vehicle with the Open-topped
Sub-type and a boarding plank and declares a charge in
the same turn, it adds +2 to its charge distance (to a
maximum of 12)</characteristic>
      </characteristics>
    </profile>
    <profile name="Burna Exhaust" id="cab1-40d2-2877-6553" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Any unit, friend or foe, within 3&quot; of a Vehicle with a Burna
Exhaust and at least partially within either its Side
Facings or Rear Facing when the Vehicle begins moving
suffers D3 Strength 4 AP 5 Hits. This attack counts as an
attack from a Flame weapon</characteristic>
      </characteristics>
    </profile>
    <profile name="Comms" id="487b-f949-e44d-09a7" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">As long as a model with comms is on the battlefield (but not in Reserves) then all Reserves rolls made by the controlling player may be re-rolled. In addition, a unit that includes at least one model with comms ignores the -1 penalty to Leadership imposed by the Night Fighting
rules</characteristic>
      </characteristics>
    </profile>
    <profile name="Cyborg Body" id="2f45-bca1-2dcf-8a6e" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A model with a cybork body gains the Feel No Pain (6+) special rule. If they gain another version of the Feel No Pain (X) special rule through other means, a model with a cybork body improves the value in brackets by 1 instead</characteristic>
      </characteristics>
    </profile>
    <profile name="Gitfinda" id="14b6-b518-eddb-6101" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A model with a gitfinda that remained stationary during
its Movement phase improves its Ballistic Skill by +1
during the controlling player’s following Shooting phase
In addition, a model with a gitfinda ignores the penalty to
Ballistic Skill while the Night Fighting rules are in effect.</characteristic>
      </characteristics>
    </profile>
    <profile name="Grabbin&apos; Klaw and Stikka" id="8ccd-5ef2-da15-520e" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">At the beginning of the enemy Movement phase,
nominate a single enemy Vehicle that is within 2&quot; of a
Vehicle with a grabbin’ klaw, or within 12&quot; of a Vehicle
with a stikka. On the roll of a 4+, that Vehicle may not
move this turn. Flyers and Skimmers cannot be attacked
by a grabbin’ klaw, and can only be attacked by a stikka if
the result of the roll is a 6.</characteristic>
      </characteristics>
    </profile>
    <profile name="Waaagh! Banner" id="5542-5822-1a97-e777" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">An army may only include a single Waaagh! banner. All
models in a unit that includes a Waaagh! banner gain the
Fearless special rule and the Line Sub-type as long as they remain part of that unit. All benefits are
lost immediately if the model with the Waaagh! banner is
removed as a casualty</characteristic>
      </characteristics>
    </profile>
    <profile name="Mine Layer" id="79e0-8bf9-93ef-c9aa" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">After a Vehicle with a Mine Layer moves through any Area
Terrain, the controlling player may roll a D6. On a 3+ the
Area Terrain now counts as Dangerous Terrain and the
Mine Layer may not be used again. On a 1 or 2, the Area
Terrain is unaffected but the Mine Layer may be used
again in a subsequent turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Deff Rolla" id="cbcb-c57d-b31f-dcd6" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A Vehicle with a deff rolla counts as a Super-heavy Vehicle when Ramming. Furthermore, the Vehicle may re-roll failed Dangerous Terrain tests</characteristic>
      </characteristics>
    </profile>
    <profile name="Rokkit Array" id="fadb-83c8-1a86-3376" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A rokkit array includes a twin-linked rokkit launcha. In
addition, any kannons and rokkit launchas fired by the
model with the rokkit array gain the Sunder special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Cyboar" id="016a-74f0-4f56-3790" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A model with a Cyboar that chooses to Run gains the
Shrouded (5+) special rule until the start of the controlling player’s next turn. A model with the Infantry Unit Type that selects a Cyboar as an upgrade must change its Unit Type to Cavalry, keeping any Unit Sub-types it previously had. In addition the model must change its Movement Characteristic to 14 and it gains the Hammer of Wrath (D3) and Rampage (D3) special rules</characteristic>
      </characteristics>
    </profile>
    <profile name="Deffkopta" id="5fdb-589b-fc2d-1269" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A Deffkopta has one twin-linked big shoota. In addition, a
model with a Deffkopta that chooses to Run gains the
Shrouded (5+) special rule until the start of the controlling player’s next turn</characteristic>
      </characteristics>
    </profile>
    <profile name="Warbike" id="78fc-cb29-7bfb-8192" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A Warbike has one twin-linked dakkagun. In addition, a model with a Warbike that chooses to Run gains the Shrouded (5+) special rule until the start of the controlling player’s next turn. A model with the Infantry Unit Type that selects a Warbike as an upgrade must change its Unit Type to Cavalry, keeping any Unit Sub-types it previously had. In addition the model must change its Movement Characteristic to 14 and it gains the Hammer of Wrath (1) special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dok&apos;s Tools" id="2957-1dea-5235-0c91" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">As long as the bearer is alive, all models in their unit have
the Feel No Pain (5+) special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mek&apos;s Tools" id="ece6-7267-62c5-6979" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A model with Mek’s Tools has the Battlesmith (5+) special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Reinforced Ram" id="b70a-b873-035b-9144" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A Vehicle with a reinforced ram treats its front Armour
Value as two points higher than normal when Ramming.
Furthermore, the Vehicle may re-roll failed Dangerous
Terrain tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ammo Runt" id="ab64-0b72-5f0b-ee8a" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">One Use Only. A unit with an ammo runt can re-roll one To Hit roll when shooting</characteristic>
      </characteristics>
    </profile>
    <profile name="Attack Squig" id="a64a-e4cd-4aae-25c6" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A model with an attack squig is allowed to re-roll one To Hit roll in close combat each turn</characteristic>
      </characteristics>
    </profile>
    <profile name="Distraction Grot" id="63f4-fe9d-3256-6869" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">One Use Only. A Distraction grot allows any model in the same unit to re-roll a failed Cover Save or Shrouded roll</characteristic>
      </characteristics>
    </profile>
    <profile name="Kommanda" id="9865-b722-8a14-f0cb" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Whilst a model with a Kommanda is part of the Grot Tank Battle Mob, it may re-roll the distance it moves (see the Full Speed Ahead special rule), but must accept the second result, even if it is worse. This re-roll can be used to negate any damage caused by rolling a double 1 for the squadron’s movement, as long as the second roll is not also a double 1</characteristic>
      </characteristics>
    </profile>
    <profile name="Grot Gunner" id="b0c4-7cfe-05a9-4fab" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Shooting attacks for a weapon with a grot gunner are resolved at Ballistic Skill 3. In addition, when any enemy unit that has the Vehicle Unit Type and the Flyer Sub-type enters the battlefield from Reserves, a friendly unit that has the Vehicle Unit Type and the Flyer Sub-type may make the Interceptor Advanced Reaction (see the Horus Heresy: Age of Darkness rulebook, page 309) using only Defensive weapons with grot gunners without expending a point of the Reactive player’s Reaction Allotment. This does not allow the unit to make more than one Reaction per Phase, but does allow the controlling player to exceed the normal three Reactions limit in a given Phase</characteristic>
      </characteristics>
    </profile>
    <profile name="Grot Oiler" id="8acd-5d32-7cfd-02bb" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">One Use Only. A grot oiler allows a Mek to re-roll a failed Battlesmith roll</characteristic>
      </characteristics>
    </profile>
    <profile name="Grot Orderly" id="d397-0801-87c5-c681" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">One Use Only. A grot orderly allows a Painboy’s unit to re- roll a single Feel No Pain roll or It Will Not Die roll</characteristic>
      </characteristics>
    </profile>
    <profile name="Grot Riggers" id="5fb7-6f5c-c791-e65b" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A model with grot riggers gains the It Will Not Die (6+) special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Jump Grot" id="019b-6ead-f128-a1ba" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A unit with a jump grot may re-roll all the dice when rolling for scatter as part of a Deep Strike Assault.</characteristic>
      </characteristics>
    </profile>
    <profile name="Squig Hound" id="affb-7f3a-3922-b080" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Each time a unit with a squig hound fails a Morale check it suffers D6 Strength 3 AP - Hits and must then re-roll the failed Morale check. If the re-roll is failed, it cannot be re-rolled again, and the squig hound will not inflict any further hits. In addition, enemy models cannot be deployed using the Infiltrate special rule within 18&quot; of a model with a squig hound.</characteristic>
      </characteristics>
    </profile>
    <profile name="Saw Blades" id="d572-7759-9e61-1b88" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Any unit with the Infantry Unit Type that charges a Vehicle with saw blades must make a Disordered Charge</characteristic>
      </characteristics>
    </profile>
    <profile name="Shokkjump Engine" id="d72f-140e-f1c5-d3cf" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A Vehicle with a shokkjump engine may move an extra D6&quot; when moving Flat Out. If a 6 is rolled, the model is removed from the battlefield and placed into Reserve. When returning to the battlefield it may deploy using the rules for Deep Strike Assault as though it had the Deep Strike special rule. This may allow the controlling player to perform more than a single Deep Strike Assault. If the model is not on the battlefield at the end of the game it counts as being destroyed</characteristic>
      </characteristics>
    </profile>
    <profile name="Snakebite Combat Drugs" id="3e21-c885-fee9-41a7" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Roll on the following table after deploying a model with
Snakebite combat drugs.
1: The model begins the game having already lost 1 Wound.
2: The model gains the Fleet (2) special rule.
3: The model may re-roll the dice when rolling for the number of attacks granted by the Rampage special rule and the number of hits granted by the Hammer of Wrath special rules.
4: The model gains the Preferred Enemy (Infantry) special rule.
5: The model gains the Feel No Pain (5+) special rule.
6:Roll two more D6, applying both results (re-roll any further results of 6)</characteristic>
      </characteristics>
    </profile>
    <profile name="Stikkbombs" id="7289-3773-2508-4e31" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A unit that includes at least one model with stikkbombs makes attacks at its normal Initiative Step during an Assault after it has successfully Charged through Difficult Terrain or Dangerous Terrain, but still suffers any penalties to Charge rolls imposed by Difficult Terrain or Dangerous Terrain when resolving a Charge through Difficult Terrain or Dangerous Terrain.</characteristic>
      </characteristics>
    </profile>
    <profile name="Stikkbomb Flinga" id="8eb4-82b0-fc80-202b" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Once per game, when a Flyer with a stikkbomb flinga makes the Evade Reaction, it gains the Shrouded (3+) special rule instead of Shrouded (5+).</characteristic>
      </characteristics>
    </profile>

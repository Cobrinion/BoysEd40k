  <rules>
    <rule name="Melta" id="25dd-f53c-779e-cefb" hidden="false">
      <description>When a weapon with the Melta special rule rolls to penetrate a vehicle&apos;s armour at half range or less, roll an additional D6 and discard the lowest result.</description>
    </rule>
  </rules>

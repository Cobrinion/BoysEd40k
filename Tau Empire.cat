          </costs>
        </selectionEntry>
        <selectionEntry name="Command and Control Node" id="506a-9074-dc22-57a9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2440-7ec6-b4c3-0f3b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="f025-b03d-07ad-eeda" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
          </costs>
          <profiles>
            <profile name="Command and Control Node" id="bce1-1bc4-516d-7126" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">If a model with this wargear does not shoot in the Shooting phase, all Shooting attacks made by other models in his unit re-roll failed To Hit rolls until the end of the phase. This cannot be used when firing Overwatch. The Node can be used at the same time as a Multi-spectrum Sensor Suite.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Puretide Engram Neurochip" id="5a9e-04fe-8260-28f4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9cca-0058-4455-677c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="63f2-ea66-6f42-11ce" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
          </costs>
          <profiles>
            <profile name="Puretide Engram Neurochip" id="8884-3be1-455f-2b12" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">At the start of the bearer’s Movement phase, choose one of the following special rules: Counter-attack (1), Furious Charge (1), Monster Hunter, Stubborn or Tank Hunters. The model with the Puretide Engram Neurochip has that special rule until the start of his next Movement phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Show available rules:" id="5b68-b0ed-2cdb-8e3d" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b9ee-7cd8-93bf-fb7a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Counter-Attack" id="678f-1bc8-b916-23b7" hidden="false" targetId="2a25-a0c2-2424-ea88" type="rule"/>
                <infoLink name="Furious Charge" id="7791-8ae7-c9a1-9136" hidden="false" targetId="7ddc-eea7-3935-d6d4" type="rule"/>
                <infoLink name="Stubborn" id="e07e-295f-5e3e-8082" hidden="false" targetId="662e-c83b-a347-db5d" type="rule"/>
                <infoLink name="Monster Hunter" id="86a6-b39c-70b5-46f9" hidden="false" targetId="b543-811c-fe12-dacb" type="rule"/>
                <infoLink name="Tank Hunter" id="a2b9-850b-2fd9-ee4b" hidden="false" targetId="9e2d-57dc-bb3a-218b" type="rule"/>

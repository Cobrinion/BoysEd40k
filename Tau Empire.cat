                  </constraints>
                </entryLink>
              </entryLinks>
              <profiles>
                <profile name="Networked Markerlights" id="864c-9a38-378c-a4cf" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Networked markerlights are a specialised version of the standard markerlight system. When a unit with one or more networked markerlights makes a Shooting attack, the networked markerlights are always fired first. Once the shots from the networked markerlights are resolved, the unit can then fire their other weapons. This means that they can expend their own markerlights in order to benefit their other weapons.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="XV81 Crisis Battlesuit" id="85a0-6c74-c064-99d0" collective="false" hidden="false" import="true" type="upgrade">

      <rules>
        <rule name="Crusade of Wrath" id="989b-aa9a-335d-0795" hidden="false">
          <description>Once per game, at the beginning of your Assault phase, High Marshal Helbrecht can grant all friendly Black Templars models the Hatred and Fleet special rules until the end of that phase.</description>
        </rule>
        <rule name="Legacy of Dorn" id="6128-512d-d0af-5535" hidden="false">
          <description>The Sword of the High Marshals gives High Marshal Helbrecht a Charge Bonus of D3 Attacks instead of one.</description>
        </rule>

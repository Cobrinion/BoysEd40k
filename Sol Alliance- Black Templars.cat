    <selectionEntryGroup name="Vows of the Black Templars" id="e37d-ef50-168e-0920" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="0893-5150-d769-de38" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Abhor the Witch, Destroy the Witch!" id="cce8-3333-ed05-2fbd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a141-f82a-4e30-febd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
          </costs>
          <rules>
            <rule name="Abhor the Witch, Destroy the Witch!" id="36e6-6b4a-189b-1a0d" hidden="false">
              <description>At the beginning of the game, once all models are deployed but before the first time, if there is a psyker in the enemy army, each unit must make a run move towards the nearest visible enemy unit.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Accept any Challenge, No Matter the Odds!" id="55d5-940c-79da-d0dc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7549-19d4-8859-5012" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="20"/>
          </costs>
          <rules>
            <rule name="Accept any Challenge, No Matter the Odds!" id="f72a-81c5-0554-b773" hidden="false">
              <description>Black Templar&apos;s characters must issue and accept all challenges in close combat. They gain the Preferred Enemy special rule against any unit they charge, for the remainder of the turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Accept any Challenge, No Matter the Odds!" id="289e-ef9d-eccb-8188" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="33e9-9334-fe56-bd2e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="20"/>
          </costs>
          <rules>
            <rule name="Accept any Challenge, No Matter the Odds!" id="4abf-d93c-7311-41bb" hidden="false">
              <description>Black Templar&apos;s characters must issue and accept all challenges in close combat. They gain the Preferred Enemy special rule against any unit they charge, for the remainder of the turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Uphold the Honour of the Emperor!" id="0648-606a-407b-2d69" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b30c-7f5c-d88d-5632" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="25"/>
          </costs>
          <rules>
            <rule name="Uphold the Honour of the Emperor!" id="a717-aab5-726a-a8e8" hidden="false">
              <description>The Black Templars gain a 6+ Invulnurable save and may never be pinned. However they may never benefit from Cover saves of any kind. Vehicles and Neophytes are unaffected by this vow.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>

      <rules>
        <rule name="Crusader Seals" id="965e-9fa0-e99d-077b" hidden="false">
          <description>Waxen vows of piety bestowned upon Black Templars of proven zeal and courage. A Crusader Seal increases the unit&apos;s Adamantium Will special rule to (4+).</description>
        </rule>
      </rules>
    </selectionEntry>

                  </infoLinks>
                  <rules>
                    <rule name="Corpulescence" id="f498-3e4c-8e99-473d" hidden="false">
                      <description>The Daemon has +1 Wound and the It Will Not Die special rule.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="2-Daemonic Resilience" id="2469-c43a-3770-8536" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>

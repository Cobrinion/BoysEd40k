                  <modifiers>
                    <modifier field="name" type="set" value="Poisoned (2+)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <profiles>
                <profile name="Plague Banner" id="ae5c-75db-76f5-b0ef" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A plague banner is an Icon of Chaos. Once per game, at the start of the Fight sub-phase, the unit can declare it is using the plague banner. If it does so, its melee weapons have the Poisoned (2+) special rule until the end of the phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>

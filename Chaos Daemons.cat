    <selectionEntry name="Feculent Gnarlmaw" id="f5f3-0104-2151-8f03" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="70"/>
      </costs>
      <profiles>
        <profile name="Feculent Gnarlmaw" id="2b5f-e6c4-bce4-c01d" hidden="false" typeId="35bb-3fdd-dd9d-1fc8" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="2ba2-3a82-dfb7-7849">Fortification, Heavy</characteristic>
            <characteristic name="M" typeId="e8fa-a6b3-0e8c-18aa">-</characteristic>
            <characteristic name="WS" typeId="9660-0df5-9c5d-3604">-</characteristic>
            <characteristic name="BS" typeId="565d-bf36-9e7e-29b5">-</characteristic>
            <characteristic name="S" typeId="23ae-6026-aebd-abc3"/>
            <characteristic name="T" typeId="f6db-a6a5-71d2-71c5">7</characteristic>
            <characteristic name="W" typeId="a763-cbc8-2080-a4fb">4</characteristic>
            <characteristic name="I" typeId="ea41-893b-3f82-5482">-</characteristic>
            <characteristic name="A" typeId="d535-b745-b613-a7ab">-</characteristic>
            <characteristic name="Ld" typeId="3b5e-ab67-ed36-a88f">-</characteristic>
            <characteristic name="Save" typeId="d33e-1fdc-0c00-8cb8">4+</characteristic>
            <characteristic name="Special Rules" typeId="3df9-f556-8725-fe75"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="The Garden Grows" id="0af5-b7d6-e278-ff99" hidden="false">
          <description>At the start of the game, place the Feculent Gnarlmaw anywhere on the gameboard, at least 12&quot; away from any enemy models, and outside of the enemy deployment zone.</description>
        </rule>
        <rule name="The Plague Bells Chime" id="355d-0fc5-1610-85f5" hidden="false">
          <description>Friendy units with the Daemon of Nurgle special rule ignore negative effects of the Slow and Purposeful Special rule whilst within 12&quot; of a Feculent Gnarlmaw.</description>
        </rule>
        <rule name="Sickness Blossoms" id="a050-bcfa-d9c7-9534" hidden="false">
          <description>Enemy units within 6&quot; of a Feculent Gnarlmaw  take D6 S1, AP - Hits with the Poison (4+) special rule at the beginning of the combat phase.</description>
        </rule>
        <rule name="Shroud of Flies" id="2bf9-84f9-0e1a-f7f6" hidden="false">
          <description>Friendly Units with the Daemon of Nurgle special rule gain +1 to their cover saves.</description>
        </rule>
      </rules>
    </selectionEntry>
  </sharedSelectionEntries>
  <sharedSelectionEntryGroups>
    <selectionEntryGroup name="Daemonic Rewards" id="cd76-5043-44cb-bd9f" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Show Rewards Tutorial" id="8a82-2287-037e-94d2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c1f9-d973-13ad-61db" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
          </costs>
          <rules>
            <rule name="Show Lesser Rewards" id="539d-a73d-399f-3ea5" hidden="false">
              <description>Each character may purchase a selection of Lesser, Greater and Exalted Rewards in any combination. Each character in your army randomly determines which reward it has. Roll a D6 on the Reward tables below. Each reward can be duplicated across the army, but can only be taken once per model, even if the reward is included in the model&apos;s default rules. (Duplicate results must be re-rolled). 
Once all of a character&apos;s rewards are determined, he  can choose to swap a single Lesser and or Greater and or Exalted reward for a result of zero.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Lesser Rewards" id="8c43-5c5b-99de-1f93" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6988-44b5-f29e-840d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>

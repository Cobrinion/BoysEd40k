                    <characteristic name="AP" typeId="1544-3a5e-d421-edf9">-</characteristic>
                    <characteristic name="Type" typeId="79ff-eaa1-5809-53f3">Melee, Instant Death, Poisoned (4+), Specialist Weapon, Touch of Rust</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Gnarlrod" id="7b1c-4cbf-534f-6163" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="25"/>
              </costs>
              <profiles>
                <profile name="Gnarlrod" id="3de2-7d88-f203-35c1" hidden="false" typeId="66fe-f217-d00c-847a" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="1fc0-83ca-e978-5a16">-</characteristic>
                    <characteristic name="Strength" typeId="cb5e-ad7f-f63b-41cd">+1</characteristic>
                    <characteristic name="AP" typeId="1544-3a5e-d421-edf9">-</characteristic>
                    <characteristic name="Type" typeId="79ff-eaa1-5809-53f3">Melee, Specialist Weapon, Conduit</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Conduit" id="146e-4873-36a8-6ba8" hidden="false">
                  <description>A Gnarldrod acts as a conduit for psychic abilities and allows the wielder access to two psychic disciplines instead of one.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Warpstorm Table" id="4bf1-c1ab-45dc-130e" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="6764-1d90-4f69-50af" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
      </costs>
      <profiles>
        <profile name="Warp Surge (8)" id="2b0e-6324-4480-0d6d" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
          <characteristics>
            <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Increase the invulnurable save of all models with the Daemon special rule on the battlefield by +1 for the remainder of the turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Storm Grows (8)" id="d2b9-4bb6-78ae-2fc6" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
          <characteristics>
            <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Increase the Strength and Toughness characteristic of all units with the Daemon special rule by +1. This ability is only usable from turn 3 onwards.</characteristic>
          </characteristics>
        </profile>
        <profile name="Malicious Misdirection (1-4)" id="1bff-c1fb-dfe2-9b52" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
          <characteristics>
            <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Cast when a scatter dice is rolled
Increase the distance moved by any scatter dice rolled by the enemy by 1&quot; for each warpstorm point used up to four inches. This ability has no effect on a direct hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Insidious Whispers (6)" id="85ae-257e-11c6-7c10" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
          <characteristics>
            <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Cast at the start of the turn.
Whispers from the warp distract even the most seasoned psykers. Enemy psykers reduce their leadership by 2 for the purpose of any psychic abilities they cast this turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Warpstorm Table" id="a642-ec35-acb9-5e11" hidden="false">
          <description>Reality warps around Daemonic enemies. At the beginning of each turn that any Daemon army is in play, the player controlling the Daemon army may roll a D3 and add the number to their Warpstorm Points. These points can then be spent on abilities dedicated to the Chaos Pantheon of their choice. In additon, any Psykers in the Daemon army may choose to roll an additional D3 dice instaed of casting any Psychic abilities that turn.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Warpstorm of Nurgle" id="2459-0af8-5aac-0877" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f83f-49c2-8823-89b4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
          </costs>
          <selectionEntryGroups>
            <selectionEntryGroup name="Warpstorms of Nurgle" id="25f1-1ce0-3da6-c57f" collective="false" hidden="false" import="true">
              <selectionEntries>
                <selectionEntry name="The Rot spreads (3-9)" id="94c4-6b44-bdae-6c1b" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="a651-6311-eecd-729f" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                    <constraint id="966d-7628-466b-f561" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="The Rot spreads (3-9)" id="006a-0410-b70c-5a30" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
                      <characteristics>
                        <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Nurgle&apos;s rot spreads across the battlefield. The controlling player may place Bulbous Ooze are on the map in the same way as they would if they were placing the unit as normal. This ability costs 3 warpstorm points for each Bulbous Ooze summoned up to a maximum of 9 points.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Debilitating Pestilence (1)" id="b3c2-7659-5d5f-2a00" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="c28a-ebd8-835a-d076" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="736b-4d5d-2881-81f5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Debilitating Pestilence (1-3)" id="699a-38fd-5747-cd4a" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
                      <characteristics>
                        <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Choose an enemy unit which is engaged in close combat. That unit must make a leadership check. If it fails, their Weapon Skill and Initiative are reduced by 1. For each additional warpstorm point spend on this ability after 1, reduce the leadership of the targeted unit by 1 for the purpose of this test by a maximum of -3</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Swarming Insects (6)" id="0700-cd2e-1d61-3fe8" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="983e-2e91-e9e8-3fb1" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                    <constraint id="d357-4914-ae6a-a4dd" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Swarming Insects (6)" id="30de-1ad2-5a1f-570f" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
                      <characteristics>
                        <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Insects swarm around the Daemons of Nurgle in a frenzy. Increase the shrouded special rule for all Daemons of Nurgle by +1. Usually this becomes shrouded (5+).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Rot, Glorious Rot (6)" id="891f-139e-f65f-f32c" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="826b-3b02-cb6e-5973" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="e8ae-cea6-e33f-95b1" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Rot, Glorious Rot (6)" id="56d3-3fa8-2b40-3e69" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
                      <characteristics>
                        <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Nurgle&apos;s plagues blossom across reality.
Roll a D6 for each unengaged enemy unit, on the battlefield. On the roll of a 6 that unit suffers D6 Strength 4 AP3 hits. These hits have the Poisoned (4+) and Ignores Cover special rules. Vehicles are hit on their side armour. Wounds are allocated by the unit’s controlling player.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
        <selectionEntry name="Warpstorm of Slaanesh" id="62ea-f7fe-0cba-1b8a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="102d-7baf-06e0-d080" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Death Ecstacy (1-3)" id="ba6b-caaf-8edd-84e6" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0a11-40b6-754c-81b6" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="a0c1-dfeb-1f80-1f9f" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <profiles>
                <profile name="Death Ecstacy (1-3)" id="e1db-6ba3-dfd2-186a" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
                  <characteristics>
                    <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Choose a model who has fallen in battle during a challenge this turn. The model may make a final attack before it succumbs to it&apos;s wounds. 
The model attacks once for each Warp Point spent, up to a maximum of three.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Dark Hallucinations (8)" id="4966-8e29-ddfa-9416" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9f5e-2665-c549-ee32" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="a2c4-c484-e33b-2e4a" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <profiles>
                <profile name="Dark Hallucinations (8)" id="600a-f24a-e5dc-97de" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
                  <characteristics>
                    <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Cast at the start of the enemy turn.
The smell of perfumes coats the battlefield, creating dark hallucinations that can trick even the most seasoned warriors. 
When an enemy unit attempts to shoot or charge, it must make a leadership test. If it fails, the Dark Hallucinations overpower them, the unit suffers 1d6 Str 4 AP - hits.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Lightning Speed (3-6)" id="513f-59d3-1841-7ba8" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ecce-a2dd-e502-34b3" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="c24e-807a-013d-515a" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <profiles>
                <profile name="Lightning Speed (3-6)" id="dc40-e94e-fe29-17ee" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
                  <characteristics>
                    <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Cast at the start of the turn. Units with the Daemon of Slaanesh or Mark of Slaanesh special rule may add +1 to all charges and run moves this turn. They may instead add +2 for the cost of 6 Warp Points.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Mesmerising Dance (3)" id="6004-ba6c-e542-e6a8" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="106b-e6ca-5f24-2be1" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="6ec6-3d34-1c85-6ceb" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <profiles>
                <profile name="Mesmerising Dance (3)" id="0dc7-8eb6-ea83-e472" hidden="false" typeId="479e-e1a8-1cd4-f3be" typeName="Psychic Ability">
                  <characteristics>
                    <characteristic name="Effect" typeId="e234-f7ad-e292-5d62">Cast during the Fight Phase.
Enemy units in combat must make a blind test.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>

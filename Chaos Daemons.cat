                <profile name="Bilesword" id="dffd-9ff7-b29b-2a30" hidden="false" typeId="66fe-f217-d00c-847a" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="1fc0-83ca-e978-5a16">-</characteristic>

            <selectionEntry name="Enhanced data-tether" id="5738-87fe-461c-293d" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="07b8-41ce-a4b1-8b11" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="5"/>
              </costs>
              <rules>
                <rule name="Enhanced data-tether" id="84e6-2d94-1db0-37f4" hidden="false">
                  <description>Whenever a unit with an enhanced data-tether is affected by a Doctrina Imperative, all models in the unit add 1 to the Leadership characteristic on their profile until the start of your next turn. Note this is not cumulative with the effects of a broad spectrum data-tether.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Omnispex" id="a188-15c2-b368-638d" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a9ae-4e3d-5675-9185" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="10"/>
              </costs>
              <rules>
                <rule name="Omnispex" id="8317-3832-736c-6526" hidden="false">
                  <description>Cover saves taken against attacks made by a unit that contains at least one model equipped with an omnispex are made with a -1 modifier.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>

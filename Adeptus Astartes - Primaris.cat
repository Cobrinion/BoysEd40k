            <characteristic name="I" typeId="ea41-893b-3f82-5482">6</characteristic>
            <characteristic name="A" typeId="d535-b745-b613-a7ab">6</characteristic>
            <characteristic name="Ld" typeId="3b5e-ab67-ed36-a88f">10</characteristic>
            <characteristic name="Save" typeId="d33e-1fdc-0c00-8cb8">2+/3++</characteristic>
            <characteristic name="Special Rules" typeId="3df9-f556-8725-fe75">It Will Not Die (5+); Eternal Warrior; Fearless; Bulky (4); Relentless; Calculating Swordsman; Lord Commander of Imperium Secundus; Primarch; Primarch of the XIII Legion</characteristic>
          </characteristics>
        </profile>
        <profile name="The Emperor&apos;s Sword" id="0308-94ac-e765-ff92" hidden="false" typeId="66fe-f217-d00c-847a" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="1fc0-83ca-e978-5a16">-</characteristic>

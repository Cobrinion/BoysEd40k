          <rules>
            <rule name="Ultramarines " id="8767-17c7-3c45-a3df" hidden="false">
              <description>Add 1 to the Leadership characteristic of models with this tactic. 
-If an enemy unit is targeted with a ranged weapon by a unit with this tactic,  ranged attacks by subsequent units this turn add +1 to hit against that target.</description>
            </rule>

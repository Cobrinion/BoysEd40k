    <selectionEntry name="Angron, Daemon Primarch of Khorne" id="1b93-59d1-182f-47a1" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="5b43-eeb0-9a96-e814" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>

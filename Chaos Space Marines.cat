              <profiles>
                <profile name="Searchlight" id="16c6-8c58-756d-5fd2" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Night fighting only. After firing all of it&apos;s weapons, this model can choose to illuminate its target with the searchlight. If it does, it also illuminates itself.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Smoke Launchers" id="c5e8-22b9-28d8-90ce" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Once per game, instead of shooting or flat out movements/running, this vehicle can activate smoke launchers. It may not fire its weapons that turn but it recieves a 5+ cover save until the next player turn. This is unaffected by weapon destroyed, crew shaken and crew stunned results.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Atomic Shielding" id="bfca-1d50-2c27-c2cb" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3a15-2309-7f6f-358c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="0a30-c1df-8cdd-784f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
              </costs>
              <profiles>
                <profile name="Atomatic Deflector" id="79d0-f123-6dd5-a7ce" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A model with an Automatic Deflector gains a 5+ invulnurable save and any model with an atomatic deflector and a wounds characteristic that suffers an unsaved wound with the Instant Death special rule is not immediatly removed as a casualty, but instead loses D3 wounds instead of one for each Wound with the Instant Death rule inflicted on it. In addition, when a model with this rule loses its last wound or hull point but before it is removed as a casualty, all models within 6&quot; suffer an automatic hit at Strength 8 AP -</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>

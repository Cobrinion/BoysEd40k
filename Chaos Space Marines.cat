      </costs>
      <infoLinks>
        <infoLink name="Daemonic Wings" id="b136-11c7-fcfb-76bb" hidden="false" targetId="b2ae-d12d-4a10-1871" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="Angron, Daemon Primarch of Khorne" id="554a-d06b-1af3-81cd" hidden="false" typeId="35bb-3fdd-dd9d-1fc8" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="2ba2-3a82-dfb7-7849">Primarch, Flying Monsterous Creature, Deamon</characteristic>
            <characteristic name="M" typeId="e8fa-a6b3-0e8c-18aa">8&quot;</characteristic>
            <characteristic name="WS" typeId="9660-0df5-9c5d-3604">10</characteristic>
            <characteristic name="BS" typeId="565d-bf36-9e7e-29b5">-</characteristic>
            <characteristic name="S" typeId="23ae-6026-aebd-abc3">7</characteristic>
            <characteristic name="T" typeId="f6db-a6a5-71d2-71c5">7</characteristic>
            <characteristic name="W" typeId="a763-cbc8-2080-a4fb">7</characteristic>
            <characteristic name="I" typeId="ea41-893b-3f82-5482">6</characteristic>
            <characteristic name="A" typeId="d535-b745-b613-a7ab">6</characteristic>
            <characteristic name="Ld" typeId="3b5e-ab67-ed36-a88f">10</characteristic>
            <characteristic name="Save" typeId="d33e-1fdc-0c00-8cb8">2+/4++</characteristic>
            <characteristic name="Special Rules" typeId="3df9-f556-8725-fe75">Rampage (3), Furious Charge (3), Hatred (Everything), Adamantium Will (3+), Bulky (4), Eternal Warrior, Fearless, It Will Not Die (5), Relentless</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unending Rage of Khorne" id="0a48-5f6c-5cf7-2e1c" hidden="false">
          <description>Lost to the rage of Khorne, Angron no longer provides any buffs to his sons. Instead, Angron receives the Feel No Pain, 4+ Special Rule. In addition, Angron can never be placed into any kind of Reserves or Deepstrikes.</description>
        </rule>
        <rule name="The Red Angel" id="05ac-7877-f680-17f3" hidden="false">
          <description>At the start of the controlling player&apos;s turn after the first, Angron gains +1 to his attack characteristic for the rest of the battle, to a maximum of 10. Additionally, any To Hit rolls made in the Assault phase targeting a unit that includes Angron always count the majority weapon skill of the target as 3 regardless of any actual weapon skills of the target.</description>
        </rule>
        <rule name="The Blessing of Khorne" id="7891-f1b9-dd54-e165" hidden="false">
          <description>Units that have the Veterans of the Long War special rule have the Adamantium Will, Furious Charge and Fearless special rules.</description>
        </rule>
        <rule name="The Butcher&apos;s Nails" id="7f7e-5ba1-9d76-148b" hidden="false">
          <description>Units with this special rule must always make Sweeping Advances if able, but cannot voluntarily Go to Ground or fail a Morale check. They must always Consolidate towards the nearest enemy unit they are able to harm.</description>
        </rule>
        <rule name="Veterans of the Long War" id="d523-2809-ebac-5d94" hidden="false">
          <description>Models with this rule have +1ld and Hatred (Space Marines). This hatred applies to all Adeptus Astartes factions.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Gorefather" id="dcd8-b48c-ab75-6e75" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b848-1a09-417a-3ed0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="6d6b-94d8-31e1-7553" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>

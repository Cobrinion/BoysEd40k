                  </costs>
                  <modifiers>
                    <modifier field="e7de-8dcf-403a-b76a" type="increment" value="2"/>
                  </modifiers>
                  <profiles>
                    <profile name="Mark of Khorne" id="9170-6a8e-9434-e2e7" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                      <characteristics>
                        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Models with the Mark of Khorne have the Rage (2) and Counter-Attack special rules.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Mark of Slaanesh" id="e072-d2f2-f2f5-3dac" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
                  </costs>
                  <modifiers>
                    <modifier field="e7de-8dcf-403a-b76a" type="increment" value="2"/>
                  </modifiers>
                  <profiles>
                    <profile name="Mark of Slaanesh" id="905f-5adc-4e39-3b13" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                      <characteristics>
                        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Models with the Mark of Slaanesh gain +1 Initiative</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Mark of Tzeentch" id="dd19-0e27-8bca-6707" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
                  </costs>
                  <modifiers>
                    <modifier field="e7de-8dcf-403a-b76a" type="increment" value="2"/>
                  </modifiers>
                  <profiles>
                    <profile name="Mark of Tzeentch" id="0d7c-d560-8aa6-9028" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                      <characteristics>
                        <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Models with the Mark of Tzeentch improve invulnurable saves +1 (To a max of 3++). Models without an invulnurable save instead gain a 6+ invulnurable save.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Mark of Nurgle" id="738b-0361-e06a-cfcd" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>

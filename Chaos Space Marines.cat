    <selectionEntryGroup name="Emperor&apos;s Children Warlord Traits" id="a1fc-3005-e9d3-9821" collective="false" hidden="true" import="true">
      <constraints>
        <constraint id="7c56-e118-629f-d6f8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="9bda-7c1f-0f29-2044" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry name="Paragon of Excellence" id="8cb4-3082-3f2e-6a75" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d99b-b935-6d02-81e5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
          </costs>
          <rules>
            <rule name="Paragon of Excellence" id="e338-655b-2be6-bf07" hidden="false">
              <description>When any friendly unit within 12&quot; of a Warlord with this Trait, including the Warlord and any unit he has joined, passes a Morale check, it gains +1 Weapon Skill until the end of the controlling players next turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Stimulated by Pain" id="4802-9a7e-857a-341e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8e8d-6fd5-9ab4-0b55" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="15"/>
          </costs>
          <rules>
            <rule name="Stimulated by Pain" id="07d4-75e3-96f7-affd" hidden="false">
              <description>The warlords of the Emperor’s Children thrive on pain. The more grievous their injuries, the deadlier they become.
Your Warlord&apos;s profile gains 1 Attack each time a wound is allocated to them.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Nexus of Debauchery" id="552c-b780-db0e-a194" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>

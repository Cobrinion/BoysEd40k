            <selectionEntry name="Searchlight and Smoke Launchers" id="930d-0d10-5aae-452e" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="769b-5005-9685-6b0d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="2150-e113-d55b-3686" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>

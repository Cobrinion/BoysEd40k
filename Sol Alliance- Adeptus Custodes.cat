              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="76e2-f66a-cd0d-1a93" type="max"/>
              </constraints>
              <profiles>
                <profile id="a04b-d20a-9e34-b9d1" name="Teleportation Transponder" publicationId="3ff9-2058-b559-545b" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A unit comprising models that are all equipped with teleportation transponders gains the Deep Strike rule.</characteristic>

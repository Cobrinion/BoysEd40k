        <selectionEntryGroup id="be91-0e84-655f-df0a" name="Entire Squad may be equipped with:" hidden="false" collective="false" import="true">
          <selectionEntries>
            <selectionEntry id="1b53-5be1-c9a8-d74c" name="Arae-Shrikes" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="increment" field="e7de-8dcf-403a-b76a" value="15">
                  <repeats>
                    <repeat field="selections" scope="8a09-a245-865b-d03c" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9f7b-480b-1e2d-ef88" type="max"/>
              </constraints>
              <profiles>
                <profile id="3a2f-daa9-62ed-7699" name="Arae-Shrikes (Deep Strike Interference)" publicationId="3ff9-2058-b559-545b" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">When an enemy unit attempts to land via Deep Strike within 12&quot; of a model equipped with an Arae-shrike, roll a D6 before they determine the result of their Deep Strike landing. On a 4+, the unit suffers a Deep Strike Mishap instead of landing – note that even models usually immune to Deep Strike Mishaps such as those that have Inertial Guidance systems or who do not usually scatter while Deep Striking are still subject to this effect.</characteristic>
                  </characteristics>
                </profile>
                <profile id="4701-3c50-c1db-26d9" name="Arae-Shrikes (Targeting Interference)" publicationId="3ff9-2058-b559-545b" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">When a unit containing one or more models with an Arae-shrike is targeted by a weapon with the Barrage type, the attacking player must roll an additional D6 for the weapon’s Scatter distance and pick the highest two results. A Hit on the Scatter dice remains a Hit however.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="06c4-471b-1759-4e95" name="Melta-bombs" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="increment" field="e7de-8dcf-403a-b76a" value="5">

    <selectionEntry id="3882-b8a8-1952-7d3c" name="Pallas Grav-Attack Squadron" hidden="false" collective="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>

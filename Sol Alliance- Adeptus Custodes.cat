              <conditions>
                <condition childId="any" field="e7de-8dcf-403a-b76a" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="false" type="atLeast" value="2000"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Legio Custodes Tribune" id="0d20-ad5f-ef4b-5caf" hidden="false">
              <description>A Custodes Tribune retains all the rules and options listed previously, but gains the Fearless and Eternal Warrior special rules and +1 wounds. In addition, you may select rather than randomly determine a Warlord Trait for them. If present in your Primary Detachment, a Legio Custodes Tribune must be your Warlord unless Constantin Valdor, Trajann Valoris, Aleya or Valerian are in your force.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>

    <selectionEntry id="515b-5179-d3fb-948a" name="Contemptor Achillus Dreadnought" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="06c8-ad05-1840-7765" name="Contemptor-Achillus Dreadnought" publicationId="3ff9-2058-b559-545b" hidden="false" typeId="17f0-d093-bacf-886d" typeName="Dreadnought">
          <characteristics>
            <characteristic name="M" typeId="8fac-a846-de69-9178">8&quot;</characteristic>
            <characteristic name="WS" typeId="ffe9-2a7f-bd4e-66cc">6</characteristic>
            <characteristic name="BS" typeId="0ddb-0fe2-6393-7c9e">5</characteristic>
            <characteristic name="S" typeId="860b-ab05-e422-b9db">8</characteristic>
            <characteristic name="T" typeId="8fc3-a8c7-c14d-9e62">7</characteristic>
            <characteristic name="W" typeId="7e98-a40e-cf96-4a4b">6</characteristic>
            <characteristic name="I" typeId="f7c5-664d-a82a-946f">4</characteristic>
            <characteristic name="A" typeId="b53b-1fc5-02c8-e69b">4</characteristic>
            <characteristic name="Ld" typeId="3886-1fbc-9ba4-cb2c">10</characteristic>
            <characteristic name="Save" typeId="ab97-0508-cfbe-db94">2+</characteristic>
            <characteristic name="Special Rules" typeId="c5fa-39b7-33f9-cb47">Dreadnought, Legio Custodes,</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Atomantic Deflector" id="ee89-4b27-5228-48a4" hidden="false" type="profile" targetId="cd7c-46f6-7711-85b3"/>
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="6784-4549-08c6-d1ec" name="Searchlight and Smoke Launchers" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="59bc-05bd-7f53-134f" type="max"/>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cf13-a1ef-30d0-c2a6" type="min"/>
          </constraints>
          <profiles>
            <profile id="7f34-7065-7a7e-a956" name="Searchlight" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Night fighting only. After firing all of it&apos;s weapons, this model can choose to illuminate its target with the searchlight. If it does, it also illuminates itself.</characteristic>
              </characteristics>
            </profile>
            <profile id="0c6f-6b13-c25d-edcd" name="Smoke Launchers" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">Once per game, instead of shooting or flat out movements/running, this vehicle can activate smoke launchers. It may not fire its weapons that turn but it recieves a 5+ cover save until the next player turn. This is unaffected by weapon destroyed, crew shaken and crew stunned results.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup id="e108-8acf-cbcf-8e25" name="Weapon Selections:" hidden="false" collective="false" import="true" defaultSelectionEntryId="7cd1-b13c-c189-0177">

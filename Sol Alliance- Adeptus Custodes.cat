          </costs>
        </selectionEntry>
        <selectionEntry id="3504-2f08-796a-6fb3" name="One may replace his Shield with a Magisterium Vexilla:" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="876a-830b-0c82-2c4e" type="max"/>
          </constraints>
          <profiles>
            <profile id="87d6-0ce4-de09-f18f" name="Magesterium Vexilla" publicationId="3ff9-2058-b559-545b" hidden="false" typeId="d4b8-6c36-8bad-c884" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="a1cc-ea5e-6a1d-d78e">A unit with the Magisterium Vexilla may re-roll failed Leadership tests and gains the Fear special rule. In addition, you may add +1 to the Wounds score calculated to see if any friendly unit with any models within 12&quot; of any magisterium vexilla wins a combat in the assault phase - this bonus only applies once.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="10"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup id="2cb3-2933-e539-b49c" name="May Replace his Sentinel Warblade with:" hidden="false" collective="false" import="true" defaultSelectionEntryId="a9b5-3cd6-9d49-b3f8">

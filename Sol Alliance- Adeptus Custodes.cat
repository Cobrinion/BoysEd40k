            <modifier type="set" field="f05b-aafd-8f10-06dc" value="1">
              <conditions>
                <condition field="e7de-8dcf-403a-b76a" scope="force" value="2000" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" childId="any" type="atLeast"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="roster" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="f05b-aafd-8f10-06dc" type="max"/>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="d653-b504-3360-6094" type="max"/>
          </constraints>
          <rules>
            <rule id="0d20-ad5f-ef4b-5caf" name="Legio Custodes Tribune" hidden="false">
              <description>A Custodes Tribune retains all the rules and options listed previously, but gains the Fearless and Eternal Warrior special rules and +1 wounds. In addition, you may select rather than randomly determine a Warlord Trait for them. If present in your Primary Detachment, a Legio Custodes Tribune must be your Warlord unless Constantin Valdor, Trajann Valoris, Aleya or Valerian are in your force.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="e7de-8dcf-403a-b76a" value="50"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup id="62b5-e07a-a841-23e8" name="May be equipped with any of the following:" hidden="false" collective="false" import="true">
          <selectionEntries>

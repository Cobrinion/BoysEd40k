      <profiles>
        <profile id="1b3b-afda-9948-d6fd" name="Dawneagle" hidden="false" typeId="35bb-3fdd-dd9d-1fc8" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="2ba2-3a82-dfb7-7849">Bike</characteristic>
            <characteristic name="M" typeId="e8fa-a6b3-0e8c-18aa">14&quot;</characteristic>

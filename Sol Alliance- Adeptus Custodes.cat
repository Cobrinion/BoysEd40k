      <selectionEntries>
        <selectionEntry name="Upgrade to Tribune" id="f2fe-07e7-8ad3-1a7c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f05b-aafd-8f10-06dc" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="0"/>
            <constraint id="d653-b504-3360-6094" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
